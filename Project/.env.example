# TelecomSupportSystem — primjer environment varijabli (kopiraj u .env i popuni).
# NE upisuj stvarne tajne ključeve u repo.

JWT_KEY=
SA_PASSWORD=YourStrongPassword123!
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=TelecomSupportDb;User Id=sa;Password=YourStrongPassword123!;TrustServerCertificate=True;

# PB-57 / PB-58 — postojeće AI funkcionalnosti
GROQ_API_KEY=

# PB-70 — MCP Admin Copilot (zaseban Groq ključ + MCP server)
GROQ_API_KEY_2=
MCP_SERVER_URL=http://mcp-server:3001/mcp
# MCP server čita istu bazu kao backend (docker-compose prosljeđuje ConnectionStrings__DefaultConnection)
